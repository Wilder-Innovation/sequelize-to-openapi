{
  "name": "sequelize-to-openapi",
  "version": "0.1.0",
  "description": "Convert Sequelize models to OpenAPI 3.1 schemas automatically",
  "keywords": [
    "sequelize",
    "openapi",
    "openapi3",
    "swagger",
    "schema",
    "typescript",
    "codegen",
    "documentation",
    "rest",
    "api"
  ],
  "homepage": "https://github.com/Wilder-Innovation/sequelize-to-openapi#readme",
  "bugs": {
    "url": "https://github.com/Wilder-Innovation/sequelize-to-openapi/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wilder-Innovation/sequelize-to-openapi.git"
  },
  "license": "MIT",
  "author": "",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/fix-cjs-ext.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "sequelize": ">=6.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "sqlite3": "^5.1.7",
    "sequelize": "^6.37.1",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
